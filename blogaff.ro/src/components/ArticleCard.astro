---
import type { Article } from '../types/article';

interface Props {
  article: Article;
}

const { article } = Astro.props;

// Capitalizează primul cuvânt din titlu
const capitalizeFirstWord = (str: string) => {
  if (!str) return str;
  return str.charAt(0).toUpperCase() + str.slice(1);
};
---

<article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
  {article.imageUrl ? (
    <!-- Imagine WebP de pe Freepik -->
    <div class="aspect-video w-full overflow-hidden bg-stone-200">
      <img
        src={article.imageUrl}
        alt={article.title}
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  ) : article.heroSvg ? (
    <!-- SVG fallback -->
    <div class="aspect-video w-full overflow-hidden bg-gradient-to-br from-blue-50 to-indigo-50">
      <div class="w-full h-full" set:html={article.heroSvg}></div>
    </div>
  ) : null}
  <div class="p-5 flex flex-col flex-grow">
    <div class="flex items-center gap-3 mb-3 flex-wrap">
      <span class="inline-block px-3 py-1 bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-semibold rounded-full">
        {article.mainCategory || (typeof article.category === 'string' ? article.category : article.category?.name) || 'Articol'}
      </span>
      {article.readingTime && (
        <span class="text-xs text-[var(--color-text-muted)] flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {article.readingTime} min
        </span>
      )}
    </div>

    <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-2 line-clamp-2 hover:text-[var(--color-primary)] transition-colors">
      <a href={`/${article.slug}`}>
        {capitalizeFirstWord(article.title)}
      </a>
    </h3>

    <p class="text-[var(--color-text-secondary)] text-sm mb-4 line-clamp-3 flex-grow">
      {article.description}
    </p>

    <div class="flex items-center justify-between mt-auto pt-4 border-t border-stone-100">
      <div class="flex gap-2 flex-wrap">
        {article.tags && article.tags.slice(0, 2).map((tag) => (
          <span class="text-xs text-[var(--color-text-muted)] bg-stone-100 px-2 py-1 rounded">
            #{tag}
          </span>
        ))}
      </div>
      <a
        href={`/${article.slug}`}
        class="text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] text-sm font-semibold flex items-center gap-1 group"
      >
        Citeste
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
